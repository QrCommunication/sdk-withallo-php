{
    "name": "qrcommunication/withallo-sdk",
    "description": "PHP SDK for Withallo (Allo) API — webhooks, calls, contacts, SMS and phone numbers",
    "type": "library",
    "license": "MIT",
    "keywords": ["withallo", "allo", "sms", "webhooks", "calls", "contacts", "sdk", "api"],
    "homepage": "https://github.com/QrCommunication/sdk-withallo-php",
    "authors": [
        {
            "name": "QrCommunication",
            "email": "contact@qrcommunication.com",
            "homepage": "https://qrcommunication.com"
        }
    ],
    "support": {
        "issues": "https://github.com/QrCommunication/sdk-withallo-php/issues",
        "source": "https://github.com/QrCommunication/sdk-withallo-php",
        "docs": "https://github.com/QrCommunication/sdk-withallo-php#readme"
    },
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0",
        "laravel/pint": "^1.18"
    },
    "autoload": {
        "psr-4": {
            "QrCommunication\\Withallo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "QrCommunication\\Withallo\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "lint": "pint",
        "lint-check": "pint --test"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
